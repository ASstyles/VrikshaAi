/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data
 * while providing public, read-only access to a shared data catalog. It prioritizes user
 * privacy and data integrity by default.
 *
 * Data Structure: User-specific data (UserProfile) is stored in a top-level `/users`
 * collection, with each user's data isolated under their unique ID (`/users/{userId}`).
 * A global, shared "digital herbarium" of plant information is stored in a separate
 * top-level `/plants` collection.
 *
 * Key Security Decisions:
 * - User Privacy: A user can only access their own document within the `/users` collection.
 *   Listing the entire `/users` collection is explicitly forbidden to prevent enumeration
 *   of all users.
 * - User Data Control: Users have full create, update, and delete permissions on their own
 *   `/users/{userId}` document, and no one else's.
 * - Curated Public Data: The `/plants` collection is treated as a curated dataset. It is
 *   readable by any authenticated user but cannot be modified by any client. This protects
 *   the integrity of the shared herbarium data, assuming it is managed by a backend
 *   process or administrators using privileged access.
 * - Denormalization for Authorization: The path-based security on `/users/{userId}`
 *   avoids the need for any cross-document reads (`get()`) to verify ownership, leading
 *   to simpler, faster, and more scalable rules.
 * - Structural Segregation: Private user data (`/users`) and public plant data (`/plants`)
 *   are stored in separate top-level collections. This is a secure and performant pattern
 *   that prevents accidental data leakage and simplifies list queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and reuse of logic.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checks if a document being updated or deleted actually exists.
    function isExistingDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    /**
     * @description Explicitly denies any attempt to list all documents in the /users collection.
     * @path /users
     * @allow (get) A specific user document: GET /users/user_abc (Handled by the rule below).
     * @deny (list) An authenticated user tries to list all users: GET /users.
     * @principle Prevents user enumeration to protect user privacy.
     */
    match /users {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures a user's profile and all their subcollections.
     * @path /users/{userId}
     * @allow (create) A new user creates their own profile document: CREATE /users/user_abc.
     * @deny (get) A user tries to read another user's profile: GET /users/user_xyz by user_abc.
     * @principle Enforces strict data ownership. A user has exclusive control over their own data tree.
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Provides read-only access to the public digital herbarium of plants.
     * @path /plants/{plantId}
     * @allow (list) Any signed-in user lists all plants: GET /plants.
     * @deny (create) Any user attempts to add a new plant: CREATE /plants/new_plant.
     * @principle Protects curated, shared data from unauthorized client-side modification.
     */
    match /plants/{plantId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
       // WARNING: The following rules are insecure and for demo purposes only,
      // to allow seeding the database from the client.
      // In a production environment, you should use a backend service
      // or the Firebase Console to manage this data.
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
